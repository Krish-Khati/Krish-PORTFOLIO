{
  // TypeScript settings for the Vercel serverless functions in this folder. Vercel compiles each
  // api/*.ts file with the nearest tsconfig.json — without this file it would use the repo's root
  // one (lib es2022, no types), which doesn't declare the Web APIs these functions use (fetch,
  // Request, Response, AbortSignal). They're built into Vercel's Node 24 runtime, so the DOM lib
  // declares them here. Checked locally by `pnpm run typecheck:api`.
  // "module": "NodeNext" picks each file's output format from its nearest package.json, the same way
  // Node does: api/*.ts (repo root package.json, no "type": "module") compile to CommonJS — Vercel's
  // launcher loads api/*.js as CommonJS and crashes on ES `export` syntax — while shared code under
  // scripts/ ("type": "module") compiles to real ES modules. Load those with a dynamic import():
  // Vercel's launcher rejects require() of an ES module (ERR_REQUIRE_ESM), unlike plain Node 24.
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": [],
    "strict": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "esModuleInterop": true
  },
  "include": ["*.ts"]
}
