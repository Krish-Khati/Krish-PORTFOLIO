# Copy to .env and fill in from Supabase → Project Settings → API.
# Use the anon/public key only — never the service_role key.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: image provider keys (fetch-blog-covers.ts)
# Pexels (recommended, generous free tier): https://www.pexels.com/api/ → request API key
PEXELS_API_KEY=
# Unsplash (demo: 50 req/hr, production needs approval): https://unsplash.com/developers → create app → Access Key
UNSPLASH_ACCESS_KEY=

# Optional: Supabase service role key (for fetch-covers --sync-db to write cover/cover_alt to DB)
# Get from Supabase → Project Settings → API → service_role (keep secret!)
SUPABASE_SERVICE_ROLE_KEY=