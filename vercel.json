{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npx --yes pnpm@11.22.0 install --frozen-lockfile",
  "buildCommand": "npx --yes pnpm@11.22.0 --filter @workspace/krish-portfolio run build",
  "outputDirectory": "artifacts/krish-portfolio/dist/public",
  "trailingSlash": false,
  "rewrites": [{ "source": "/((?!api/).*)", "destination": "/spa.html" }],
  "headers": [
    {
      "source": "/admin/:path*",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/admin",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/spa.html",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/(sitemap.xml|rss.xml|robots.txt)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    }
  ]
}
